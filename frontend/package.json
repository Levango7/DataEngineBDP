{
  "name": "dataengine-console",
  "version": "2.1.0-RC",
  "private": true,
  "type": "module",
  "workspaces": [
    "finops-dashboard",
    "asset-exchange-dashboard",
    "finetuning-monitor",
    "multi-cluster-dashboard",
    "open-api-dashboard"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report tests/e2e-report",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\"",
    "build:all": "npm run build && npm run build --workspace finops-dashboard && npm run build --workspace asset-exchange-dashboard && npm run build --workspace finetuning-monitor && npm run build --workspace multi-cluster-dashboard && npm run build --workspace open-api-dashboard",
    "dev:finops": "npm run dev --workspace finops-dashboard",
    "dev:asset": "npm run dev --workspace asset-exchange-dashboard",
    "dev:finetuning": "npm run dev --workspace finetuning-monitor",
    "dev:multicluster": "npm run dev --workspace multi-cluster-dashboard",
    "dev:openapi": "npm run dev --workspace open-api-dashboard",
    "type-check:all": "npm run type-check && npm run type-check --workspace finops-dashboard && npm run type-check --workspace asset-exchange-dashboard && npm run type-check --workspace finetuning-monitor && npm run type-check --workspace multi-cluster-dashboard && npm run type-check --workspace open-api-dashboard"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "dompurify": "^3.4.14",
    "echarts": "^5.5.0",
    "element-plus": "^2.8.0",
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@playwright/test": "^1.49.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vitest/coverage-istanbul": "^2.1.0",
    "@vitest/coverage-v8": "^2.1.0",
    "@vitest/ui": "^2.1.0",
    "@vue/devtools-api": "^7.7.0",
    "@vue/eslint-config-typescript": "^14.0.0",
    "@vue/test-utils": "^2.4.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.0",
    "eslint-plugin-vue": "^9.0.0",
    "happy-dom": "^15.0.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.0.0"
  }
}

