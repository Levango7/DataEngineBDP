# 强制关键脚本类文件使用 LF（防 Windows CRLF 干扰 shell/bash 语法）
.github/workflows/*.yml text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
ske/**/*.sh text eol=lf
scripts/*.sh text eol=lf
# Python 镜像文件强制 LF（防 CRLF 导致镜像不一致）
**/jwt_auth.py text eol=lf
# Sprint 2.1：自动生成的前后端 API 契约文档（CI 漂移校验要求 LF 稳定）
docs/api-contract.md text eol=lf
scripts/gen-api-contract.py text eol=lf
scripts/check-api-route-conflict.py text eol=lf
# Sprint 2.2 L2/L3：git hook 与 vite 代理校验脚本强制 LF
.githooks/* text eol=lf
scripts/verify-vite-proxy.py text eol=lf
# 2026-09-26 告警规则渲染链：模板与 chart 渲染副本都须钉 LF。
# 否则 Windows 工作区 checkout 成 CRLF，而 scripts/render-tenant-alert-rules.py
# 产出 LF → sync-alert-rules.sh --check 在开发机上误报漂移。
platform/observability/rules/*.yaml text eol=lf
platform/observability/rules/pending/*.yaml text eol=lf
design/deploy/charts/prometheus/files/rules/*.yaml text eol=lf
scripts/render-tenant-alert-rules.py text eol=lf
scripts/check-alert-rule-contract.py text eol=lf
