# 简化多架构Dockerfile - 直接使用本地预构建的jar包
# 跳过Stage 1 maven构建，加速多架构镜像构建
# 基础镜像eclipse-temurin:17-jre官方支持amd64+arm64多架构

ARG BASE_REGISTRY=docker.m.daocloud.io

FROM ${BASE_REGISTRY}/library/eclipse-temurin:17-jre-alpine AS runtime

# brotli-libs 基座为 1.2.0-r1（CVE-2026-111497），Alpine 仓库已有修复版 1.2.1-r0；
# libexpat 的豁免记的是 2.8.5-r0→2.9.0-r0，2026-11-02 新拉基座已随上游重建到
# 2.9.0-r0，但 CI 可能复用旧层，故一并列入升级。docs/trivy-image-ignore.yaml 的
# 豁免按 CVE 号全局生效，出货镜像仍须构建期自证修复（与已兜底的 8 个文件同口径）。
RUN apk upgrade --no-cache libexpat brotli-libs
WORKDIR /app

# 创建非 root 用户运行应用
RUN groupadd --system appgroup && useradd --system --gid appgroup appuser

# 直接复制本地预构建的jar包（避免在容器内重新执行maven构建）
COPY target/encaps-layer-0.1.0-SNAPSHOT.jar /app/app.jar

# 创建数据目录并赋权，确保 appuser 可写（H2 文件库 / 日志落盘）
RUN mkdir -p /app/data && chown -R appuser:appgroup /app

# 暴露服务端口
EXPOSE 8080

# 切换非 root 用户
USER appuser

# JVM 参数：容器感知，限制堆内存
ENV JAVA_OPTS="-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError"

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /app/app.jar"]