# ============================================================
# encaps-layer 本地开发环境变量示例
# 复制为 .env 并按需调整（勿将真实密钥提交到仓库）
# ============================================================

# JWT 签名密钥（≥32 字节，生产须经 KMS 外置）
JWT_SECRET=dev-only-secret-0123456789abcdef0123456789abcdef

# 字段级加密 SM4 密钥（必须为偶数长度 hex 字符串，32 字符 = 16 字节）
ENCRYPT_KEY=0123456789abcdef0123456789abcdef

# 本地降级登录（无 Keycloak 时开启）
# 注意：短名 LOCAL_AUTH_ENABLED 经 -D 不绑定，须用全路径属性
#       -Dapp.security.local-auth.enabled=true
# LOCAL_AUTH_USERNAME 默认 admin；LOCAL_AUTH_PASSWORD 默认空，
# 启用降级且密码为空时启动会随机生成 16 位强密码并通过日志一次性提示。
LOCAL_AUTH_ENABLED=false
# LOCAL_AUTH_USERNAME=admin
# LOCAL_AUTH_PASSWORD=

# 其它可选配置（均含默认值，可按需覆盖）
# JWT_ISSUER=shuqing-bigdata
# JWT_ALG=HS384
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# K8S_MOCK_ENABLED=false
# RATE_LIMIT_ENABLED=true