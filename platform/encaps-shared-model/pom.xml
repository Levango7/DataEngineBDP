<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.levango7.dataenginebdp</groupId>
        <artifactId>dataenginebdp-parent</artifactId>
        <version>2.1.0-RC</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <groupId>com.levango7.dataenginebdp</groupId>
    <artifactId>encaps-shared-model</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>encaps-shared-model</name>
    <description>
        Shuqing BigData Platform - 封装层跨服务共享实体与仓储（Tenant / Project）。

        存在的理由（2026-10-13，根治台账 #63 的遗留语义问题）：
        此前 encaps-tenant 直接依赖 encaps-layer 的 jar，而两者共享包根
        `com.levango7.dataenginebdp.encaps` ⇒ encaps-tenant 的组件扫描把
        encaps-layer 的**全部 20 个实体与全部 Controller** 都拉进自己的 JVM，
        造成三个后果：
          ① 持久单元要求 20 张不属于它的表（V3__baseline_shared_model.sql
             复制出来的空副本）；
          ② `/api/v1/tenants`、`/api/v1/projects` 双注册；
          ③ 跨服务计数读到空副本，结构性恒 0。

        encaps-tenant 真正需要的只有 Tenant 与 Project 两个域。把它们抽到本模块
        （独立包根 `com.levango7.dataenginebdp.encapsshared`，**刻意不是 `...encaps`
        的子包** —— 否则扫描仍会把 encaps-layer 的其余实体带进来），
        encaps-tenant 改依赖本模块后即可与 encaps-layer 完全解耦。

        注意：包根必须保持在 `...encaps` 之外，这是本模块存在的全部意义。
    </description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- JPA：@Entity / @Table / JpaRepository（Tenant、ProjectEntity 及两个仓储） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- Bean Validation：Tenant 的 @NotBlank 字段约束 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Lombok：实体上的 @Data / @Builder / @NoArgsConstructor 等 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Boot 4 JPA slice 测试 starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- H2：仓储 slice 测试用（使用方自带真实库） -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- JaCoCo：覆盖率采集（CI 覆盖率门禁依赖本插件生成的 jacoco.xml） -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <configuration>
                    <excludes>
                        <exclude>**/model/**</exclude>
                        <exclude>**/*Application*</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
