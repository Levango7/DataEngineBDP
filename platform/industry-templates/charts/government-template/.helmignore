# .helmignore - 政务行业模板 Helm Chart 忽略文件
# ============================================================================
# Helm 打包时忽略的文件模式
# ============================================================================

# 通用忽略
.git/
.gitignore
.github/
.idea/
.vscode/

# Python 缓存
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# 文档
README.md
docs/

# 测试
tests/
*.test
*.spec