  "charts": [
    {
      "slice_name": "交易金额趋势",
      "viz_type": "line",
      "datasource_type": "table",
      "datasource_name": "transaction",
      "schema": "db_finance",
      "database_name": "finance_doris",
      "description": "按日统计交易总额，线图，X轴=日期，Y轴=交易金额",
      "params": {
        "adhoc_filters": [
          {
            "clause": "WHERE",
            "expressionType": "SQL",
            "sqlExpression": "occurred_at >= '{{ from_dttm }}' AND occurred_at < '{{ to_dttm }}' AND status='SUCCESS'"
          }
        ],
        "x_axis": "txn_date",
        "metrics": [{"expressionType": "SQL", "sqlExpression": "SUM(amount)", "label": "交易总额"}],
        "groupby": ["txn_date"],
        "time_grain_sqla": "DAY",
        "time_range": "Last 90 days",
        "row_limit": 365,
        "color_scheme": "supersetColors",
        "x_axis_label": "日期",
        "y_axis_label": "交易总额(元)",
        "show_legend": true,
        "line_interpolation": "linear"
      },
      "query": "SELECT DATE(occurred_at) AS txn_date, SUM(amount) AS total_amount FROM transaction WHERE occurred_at >= '{{ from_dttm }}' AND occurred_at < '{{ to_dttm }}' AND status='SUCCESS' GROUP BY DATE(occurred_at) ORDER BY txn_date"
    },
    {
      "slice_name": "交易类型分布",
      "viz_type": "pie",
      "datasource_type": "table",
      "datasource_name": "transaction",
      "schema": "db_finance",
      "database_name": "finance_doris",
      "description": "按交易类型(TRANSFER/PAYMENT/DEPOSIT/WITHDRAW/REFUND)分类，饼图",
      "params": {
        "adhoc_filters": [
          {
            "clause": "WHERE",
            "expressionType": "SQL",
            "sqlExpression": "occurred_at >= '{{ from_dttm }}' AND occurred_at < '{{ to_dttm }}' AND status='SUCCESS'"
          }
        ],
        "metrics": [{"expressionType": "SQL", "sqlExpression": "SUM(amount)", "label": "交易金额"}],
        "groupby": ["txn_type"],
        "time_range": "Last 30 days",
        "row_limit": 50,
        "color_scheme": "supersetColors",
        "donut": true,
        "show_legend": true,
        "labels_outside": false
      },
      "query": "SELECT txn_type, SUM(amount) AS total_amount, COUNT(1) AS txn_count FROM transaction WHERE occurred_at >= '{{ from_dttm }}' AND occurred_at < '{{ to_dttm }}' AND status='SUCCESS' GROUP BY txn_type ORDER BY total_amount DESC"
    },
    {
      "slice_name": "大额交易Top10",
      "viz_type": "table",
      "datasource_type": "table",
      "datasource_name": "transaction",
      "schema": "db_finance",
      "database_name": "finance_doris",
      "description": "交易金额降序Top10，表格，列=交易号/客户/金额/类型/渠道/时间",
      "params": {
        "adhoc_filters": [
          {
            "clause": "WHERE",
            "expressionType": "SQL",
            "sqlExpression": "occurred_at >= '{{ from_dttm }}' AND occurred_at < '{{ to_dttm }}' AND status='SUCCESS'"
          }
        ],
        "metrics": [{"expressionType": "SIMPLE", "column": {"name": "amount"}, "aggregate": "MAX", "label": "交易金额"}],
        "groupby": ["transaction_no", "customer_id", "amount", "txn_type", "channel", "occurred_at"],
        "order_by": [{"column": "amount", "direction": "desc"}],
        "row_limit": 10,
        "page_length": 10,
        "table_timestamp_format": "%Y-%m-%d %H:%M:%S",
        "show_cell_bars": true
      },
      "query": "SELECT transaction_no, customer_id, amount, txn_type, channel, occurred_at FROM transaction WHERE occurred_at >= '{{ from_dttm }}' AND occurred_at < '{{ to_dttm }}' AND status='SUCCESS' ORDER BY amount DESC LIMIT 10"
    },
    {
      "slice_name": "AML告警统计",
      "viz_type": "bar",
      "datasource_type": "table",
      "datasource_name": "aml_alert",
      "schema": "db_finance",
      "database_name": "finance_doris",
      "description": "按AML告警级别(LOW/MEDIUM/HIGH)统计告警数，柱状图",
      "params": {
        "adhoc_filters": [
          {
            "clause": "WHERE",
            "expressionType": "SQL",
            "sqlExpression": "detected_at >= '{{ from_dttm }}' AND detected_at < '{{ to_dttm }}'"
          }
        ],
        "x_axis": "risk_level",
        "metrics": [{"expressionType": "SIMPLE", "metric": "COUNT", "label": "AML告警数"}],
        "groupby": ["risk_level"],
        "time_range": "Last 30 days",
        "row_limit": 50,
        "color_scheme": "supersetColors",
        "x_axis_label": "AML风险等级",
        "y_axis_label": "告警数",
        "show_legend": true
      },
      "query": "SELECT risk_level, COUNT(1) AS alert_count FROM aml_alert WHERE detected_at >= '{{ from_dttm }}' AND detected_at < '{{ to_dttm }}' GROUP BY risk_level ORDER BY CASE risk_level WHEN 'LOW' THEN 1 WHEN 'MEDIUM' THEN 2 WHEN 'HIGH' THEN 3 ELSE 4 END"
    },
    {
      "slice_name": "日交易总额",
      "viz_type": "big_number",
      "datasource_type": "table",
      "datasource_name": "transaction",
      "schema": "db_finance",
      "database_name": "finance_doris",
      "description": "当日交易总额，指标卡，单数值",
      "params": {
        "adhoc_filters": [
          {
            "clause": "WHERE",
            "expressionType": "SQL",
            "sqlExpression": "occurred_at >= '{{ from_dttm }}' AND occurred_at < '{{ to_dttm }}' AND status='SUCCESS'"
          }
        ],
        "metric": {"expressionType": "SQL", "sqlExpression": "SUM(amount)", "label": "日交易总额"},
        "time_range": "Last day",
        "compare_lag": 1,
        "compare_suffix": "vs yesterday",
        "header_format": "¥{{ value }}",
        "subheader": "当日成功交易总额"
      },
      "query": "SELECT SUM(amount) AS daily_total_amount FROM transaction WHERE occurred_at >= '{{ from_dttm }}' AND occurred_at < '{{ to_dttm }}' AND status='SUCCESS'"
    },
    {
      "slice_name": "交易渠道分布",
      "viz_type": "pie",
      "datasource_type": "table",
      "datasource_name": "transaction",
      "schema": "db_finance",
      "database_name": "finance_doris",
      "description": "按交易渠道(COUNTER/ONLINE/MOBILE/ATM/API)统计交易笔数，饼图",
      "params": {
        "adhoc_filters": [
          {
            "clause": "WHERE",
            "expressionType": "SQL",
            "sqlExpression": "occurred_at >= '{{ from_dttm }}' AND occurred_at < '{{ to_dttm }}' AND status='SUCCESS'"
          }
        ],
        "metrics": [{"expressionType": "SIMPLE", "metric": "COUNT", "label": "交易笔数"}],
        "groupby": ["channel"],
        "time_range": "Last 30 days",
        "row_limit": 50,
        "color_scheme": "supersetColors",
        "donut": true,
        "show_legend": true
      },
      "query": "SELECT channel, COUNT(1) AS txn_count FROM transaction WHERE occurred_at >= '{{ from_dttm }}' AND occurred_at < '{{ to_dttm }}' AND status='SUCCESS' GROUP BY channel ORDER BY txn_count DESC"
    }
  ],
