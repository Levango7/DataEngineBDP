        {"name": "eval_at", "type": "DATETIME", "is_dttm": true},
        {"name": "duration_ms", "type": "INT", "is_dttm": false},
        {"name": "created_at", "type": "DATETIME", "is_dttm": true},
        {"name": "updated_at", "type": "DATETIME", "is_dttm": true}
      ],
      "main_dttm_col": "eval_at"
    },
    {
      "table_name": "risk_alert",
      "schema": "db_finance",
      "database_name": "finance_doris",
      "description": "风控告警表 | 评估产生的告警，含命中规则/告警级别/处置状态 | DDL: 01_risk_control_ddl.sql §5",
      "columns": [
        {"name": "alert_id", "type": "VARCHAR(64)", "is_dttm": false},
        {"name": "eval_id", "type": "VARCHAR(64)", "is_dttm": false},
        {"name": "rule_id", "type": "VARCHAR(64)", "is_dttm": false},
        {"name": "alert_level", "type": "VARCHAR(8)", "is_dttm": false},
        {"name": "alert_status", "type": "VARCHAR(16)", "is_dttm": false},
        {"name": "alert_type", "type": "VARCHAR(32)", "is_dttm": false},
        {"name": "alert_detail", "type": "STRING", "is_dttm": false},
        {"name": "handle_opinion", "type": "VARCHAR(512)", "is_dttm": false},
        {"name": "handled_by", "type": "VARCHAR(64)", "is_dttm": false},
        {"name": "handled_at", "type": "DATETIME", "is_dttm": true},
        {"name": "alert_at", "type": "DATETIME", "is_dttm": true},
        {"name": "created_at", "type": "DATETIME", "is_dttm": true},
        {"name": "updated_at", "type": "DATETIME", "is_dttm": true}
      ],
      "main_dttm_col": "alert_at"
    }
  ],
  "charts": [
    {
      "slice_name": "风控评分分布",
      "viz_type": "bar",
      "datasource_type": "table",
      "datasource_name": "risk_evaluation",
      "schema": "db_finance",
      "database_name": "finance_doris",
      "description": "按评分区间统计客户数，柱状图，X轴=评分区间，Y轴=客户数",
      "params": {
        "adhoc_filters": [
          {
            "clause": "WHERE",
            "expressionType": "SQL",
            "sqlExpression": "eval_at >= '{{ from_dttm }}' AND eval_at < '{{ to_dttm }}'"
          }
        ],
        "x_axis": "score_bucket",
        "metrics": [{"expressionType": "SIMPLE", "metric": "COUNT", "label": "客户数"}],
        "groupby": ["score_bucket"],
        "time_range": "Last 30 days",
        "row_limit": 100,
        "color_scheme": "supersetColors",
        "x_axis_label": "评分区间",
        "y_axis_label": "客户数",
        "show_legend": true
      },
      "query": "SELECT CASE WHEN score < 300 THEN '0-300' WHEN score < 500 THEN '300-500' WHEN score < 600 THEN '500-600' WHEN score < 700 THEN '600-700' WHEN score < 800 THEN '700-800' ELSE '800-1000' END AS score_bucket, COUNT(DISTINCT biz_id) AS customer_count FROM risk_evaluation WHERE biz_type IN ('APPLICATION','LOAN') AND eval_at >= '{{ from_dttm }}' AND eval_at < '{{ to_dttm }}' GROUP BY score_bucket ORDER BY score_bucket"
    },
    {
      "slice_name": "风险告警趋势",
      "viz_type": "line",
      "datasource_type": "table",
      "datasource_name": "risk_alert",
      "schema": "db_finance",
      "database_name": "finance_doris",
      "description": "按日统计告警数量趋势，线图，X轴=日期，Y轴=告警数",
      "params": {
        "adhoc_filters": [
          {
            "clause": "WHERE",
            "expressionType": "SQL",
            "sqlExpression": "alert_at >= '{{ from_dttm }}' AND alert_at < '{{ to_dttm }}'"
          }
        ],
        "x_axis": "alert_date",
        "metrics": [{"expressionType": "SIMPLE", "metric": "COUNT", "label": "告警数"}],
        "groupby": ["alert_date"],
        "time_grain_sqla": "DAY",
        "time_range": "Last 90 days",
        "row_limit": 365,
        "color_scheme": "supersetColors",
        "x_axis_label": "日期",
        "y_axis_label": "告警数",
        "show_legend": true,
        "line_interpolation": "linear"
      },
      "query": "SELECT DATE(alert_at) AS alert_date, COUNT(1) AS alert_count FROM risk_alert WHERE alert_at >= '{{ from_dttm }}' AND alert_at < '{{ to_dttm }}' GROUP BY DATE(alert_at) ORDER BY alert_date"
    },
    {
      "slice_name": "告警类型占比",
      "viz_type": "pie",
      "datasource_type": "table",
      "datasource_name": "risk_alert",
      "schema": "db_finance",
      "database_name": "finance_doris",
      "description": "按告警类型分类占比，饼图，维度=alert_type",
      "params": {
        "adhoc_filters": [
          {
            "clause": "WHERE",
            "expressionType": "SQL",
            "sqlExpression": "alert_at >= '{{ from_dttm }}' AND alert_at < '{{ to_dttm }}'"
          }
        ],
        "metrics": [{"expressionType": "SIMPLE", "metric": "COUNT", "label": "告警数"}],
        "groupby": ["alert_type"],
        "time_range": "Last 30 days",
        "row_limit": 50,
        "color_scheme": "supersetColors",
        "donut": true,
        "show_legend": true,
        "labels_outside": false
      },
      "query": "SELECT COALESCE(alert_type,'UNKNOWN') AS alert_type, COUNT(1) AS alert_count FROM risk_alert WHERE alert_at >= '{{ from_dttm }}' AND alert_at < '{{ to_dttm }}' GROUP BY alert_type ORDER BY alert_count DESC"
    },
    {
      "slice_name": "风控规则命中Top10",
      "viz_type": "table",
      "datasource_type": "table",
      "datasource_name": "risk_rule",
      "schema": "db_finance",
      "database_name": "finance_doris",
      "description": "规则命中次数降序Top10，表格，列=规则名/编码/命中次数/优先级/动作",
      "params": {
        "adhoc_filters": [],
        "metrics": [{"expressionType": "SIMPLE", "column": {"name": "hit_count"}, "aggregate": "SUM", "label": "命中次数"}],
        "groupby": ["rule_name", "rule_code", "priority", "action"],
        "order_by": [{"column": "hit_count", "direction": "desc"}],
        "row_limit": 10,
        "page_length": 10,
        "table_timestamp_format": "%Y-%m-%d %H:%M:%S",
        "show_cell_bars": true
      },
      "query": "SELECT rule_name, rule_code, SUM(hit_count) AS hit_count, priority, action FROM risk_rule WHERE enabled = TRUE GROUP BY rule_name, rule_code, priority, action ORDER BY hit_count DESC LIMIT 10"
    },
    {
      "slice_name": "风控覆盖率",
      "viz_type": "big_number",
      "datasource_type": "table",
      "datasource_name": "risk_evaluation",
      "schema": "db_finance",
      "database_name": "finance_doris",
      "description": "已评估客户/总客户比率，指标卡，单数值",
      "params": {
        "adhoc_filters": [
          {
            "clause": "WHERE",
            "expressionType": "SQL",
            "sqlExpression": "eval_at >= '{{ from_dttm }}' AND eval_at < '{{ to_dttm }}'"
          }
        ],
        "metric": {"expressionType": "SQL", "sqlExpression": "ROUND(COUNT(DISTINCT biz_id) * 100.0 / NULLIF((SELECT COUNT(1) FROM customer WHERE status='ACTIVE'),0), 2)", "label": "风控覆盖率(%)"},
        "time_range": "Last 30 days",
        "compare_lag": 7,
        "compare_suffix": "vs 7d ago",
        "header_format": "{{ value }}%",
        "subheader": "已评估客户/活跃客户"
      },
      "query": "SELECT ROUND(COUNT(DISTINCT biz_id) * 100.0 / NULLIF((SELECT COUNT(1) FROM customer WHERE status='ACTIVE'),0), 2) AS coverage_rate FROM risk_evaluation WHERE eval_at >= '{{ from_dttm }}' AND eval_at < '{{ to_dttm }}'"
    },
    {
      "slice_name": "告警级别分布",
      "viz_type": "bar",
      "datasource_type": "table",
      "datasource_name": "risk_alert",
      "schema": "db_finance",
      "database_name": "finance_doris",
      "description": "按告警级别(LOW/MEDIUM/HIGH/CRITICAL)统计告警数，堆叠柱状图",
      "params": {
        "adhoc_filters": [
          {
            "clause": "WHERE",
            "expressionType": "SQL",
            "sqlExpression": "alert_at >= '{{ from_dttm }}' AND alert_at < '{{ to_dttm }}'"
          }
        ],
        "x_axis": "alert_level",
        "metrics": [{"expressionType": "SIMPLE", "metric": "COUNT", "label": "告警数"}],
        "groupby": ["alert_level"],
        "time_range": "Last 30 days",
        "row_limit": 50,
        "color_scheme": "supersetColors",
        "x_axis_label": "告警级别",
        "y_axis_label": "告警数"
      },
      "query": "SELECT alert_level, COUNT(1) AS alert_count FROM risk_alert WHERE alert_at >= '{{ from_dttm }}' AND alert_at < '{{ to_dttm }}' GROUP BY alert_level ORDER BY CASE alert_level WHEN 'LOW' THEN 1 WHEN 'MEDIUM' THEN 2 WHEN 'HIGH' THEN 3 WHEN 'CRITICAL' THEN 4 ELSE 5 END"
    }
  ],
