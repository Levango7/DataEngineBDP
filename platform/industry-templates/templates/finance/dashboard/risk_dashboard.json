    },
    {
      "table_name": "risk_evaluation",
      "schema": "db_finance",
      "database_name": "finance_doris",
      "description": "风控评估结果表 | 一次评估的输入/命中/决策 | DDL: 01_risk_control_ddl.sql §4",
      "columns": [
        {"name": "eval_id", "type": "VARCHAR(64)", "is_dttm": false},
        {"name": "model_id", "type": "VARCHAR(64)", "is_dttm": false},
