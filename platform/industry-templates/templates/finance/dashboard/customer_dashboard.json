  "charts": [
    {
      "slice_name": "客户总数增长",
      "viz_type": "line",
      "datasource_type": "table",
      "datasource_name": "customer",
      "schema": "db_finance",
      "database_name": "finance_doris",
      "description": "按月统计客户总数增长，线图，X轴=月份，Y轴=累计客户数",
      "params": {
        "adhoc_filters": [
          {
            "clause": "WHERE",
            "expressionType": "SQL",
            "sqlExpression": "created_at >= '{{ from_dttm }}' AND created_at < '{{ to_dttm }}'"
          }
        ],
        "x_axis": "month_start",
        "metrics": [{"expressionType": "SQL", "sqlExpression": "COUNT(1)", "label": "累计客户数"}],
        "groupby": ["month_start"],
        "time_grain_sqla": "MONTH",
        "time_range": "Last 12 months",
        "row_limit": 36,
        "color_scheme": "supersetColors",
        "x_axis_label": "月份",
        "y_axis_label": "累计客户数",
        "show_legend": true,
        "line_interpolation": "linear"
      },
      "query": "SELECT DATE_TRUNC('MONTH', created_at) AS month_start, COUNT(1) AS cumulative_customers FROM customer WHERE created_at >= '{{ from_dttm }}' AND created_at < '{{ to_dttm }}' GROUP BY month_start ORDER BY month_start"
    },
    {
      "slice_name": "客户标签分布",
      "viz_type": "pie",
      "datasource_type": "table",
      "datasource_name": "customer_tag",
      "schema": "db_finance",
      "database_name": "finance_doris",
      "description": "按标签分类(tag_category)统计标签数，饼图",
      "params": {
        "adhoc_filters": [
          {
            "clause": "WHERE",
            "expressionType": "SQL",
            "sqlExpression": "tagged_at >= '{{ from_dttm }}' AND tagged_at < '{{ to_dttm }}'"
          }
        ],
        "metrics": [{"expressionType": "SIMPLE", "metric": "COUNT", "label": "标签数"}],
        "groupby": ["tag_category"],
        "time_range": "Last 30 days",
        "row_limit": 50,
        "color_scheme": "supersetColors",
        "donut": true,
        "show_legend": true,
        "labels_outside": false
      },
      "query": "SELECT COALESCE(tag_category,'UNKNOWN') AS tag_category, COUNT(1) AS tag_count FROM customer_tag WHERE tagged_at >= '{{ from_dttm }}' AND tagged_at < '{{ to_dttm }}' GROUP BY tag_category ORDER BY tag_count DESC"
    },
    {
      "slice_name": "客户等级分布",
      "viz_type": "bar",
      "datasource_type": "table",
      "datasource_name": "customer",
      "schema": "db_finance",
      "database_name": "finance_doris",
      "description": "按客户风险等级(A/B/C/D/E)统计客户数，柱状图",
      "params": {
        "adhoc_filters": [
          {
            "clause": "WHERE",
            "expressionType": "SQL",
            "sqlExpression": "created_at >= '{{ from_dttm }}' AND created_at < '{{ to_dttm }}' AND status='ACTIVE'"
          }
        ],
        "x_axis": "risk_level",
        "metrics": [{"expressionType": "SIMPLE", "metric": "COUNT", "label": "客户数"}],
        "groupby": ["risk_level"],
        "time_range": "Last 30 days",
        "row_limit": 50,
        "color_scheme": "supersetColors",
        "x_axis_label": "客户风险等级",
        "y_axis_label": "客户数",
        "show_legend": true
      },
      "query": "SELECT COALESCE(risk_level,'UNKNOWN') AS risk_level, COUNT(1) AS customer_count FROM customer WHERE created_at >= '{{ from_dttm }}' AND created_at < '{{ to_dttm }}' AND status='ACTIVE' GROUP BY risk_level ORDER BY CASE risk_level WHEN 'A' THEN 1 WHEN 'B' THEN 2 WHEN 'C' THEN 3 WHEN 'D' THEN 4 WHEN 'E' THEN 5 ELSE 6 END"
    },
    {
      "slice_name": "客户关系网络Top10",
      "viz_type": "table",
      "datasource_type": "table",
      "datasource_name": "customer_relation",
      "schema": "db_finance",
      "database_name": "finance_doris",
      "description": "按关系类型聚合统计Top10，表格，列=主体客户/客体客户/关系类型/担保金额",
      "params": {
        "adhoc_filters": [
          {
            "clause": "WHERE",
            "expressionType": "SQL",
            "sqlExpression": "is_active = TRUE AND created_at >= '{{ from_dttm }}' AND created_at < '{{ to_dttm }}'"
          }
        ],
        "metrics": [{"expressionType": "SIMPLE", "column": {"name": "amount"}, "aggregate": "SUM", "label": "担保金额"}],
        "groupby": ["subject_customer_id", "object_customer_id", "relation_type"],
        "order_by": [{"column": "amount", "direction": "desc"}],
        "row_limit": 10,
        "page_length": 10,
        "table_timestamp_format": "%Y-%m-%d %H:%M:%S",
        "show_cell_bars": true
      },
      "query": "SELECT subject_customer_id, object_customer_id, relation_type, SUM(amount) AS total_amount, COUNT(1) AS relation_count FROM customer_relation WHERE is_active = TRUE AND created_at >= '{{ from_dttm }}' AND created_at < '{{ to_dttm }}' GROUP BY subject_customer_id, object_customer_id, relation_type ORDER BY total_amount DESC LIMIT 10"
    },
    {
      "slice_name": "活跃客户数",
      "viz_type": "big_number",
      "datasource_type": "table",
      "datasource_name": "customer_profile",
      "schema": "db_finance",
      "database_name": "finance_doris",
      "description": "近30天活跃客户数(lifecycle_stage=ACTIVE)，指标卡",
      "params": {
        "adhoc_filters": [
          {
            "clause": "WHERE",
            "expressionType": "SQL",
            "sqlExpression": "computed_at >= '{{ from_dttm }}' AND computed_at < '{{ to_dttm }}' AND lifecycle_stage='ACTIVE'"
          }
        ],
        "metric": {"expressionType": "SQL", "sqlExpression": "COUNT(DISTINCT customer_id)", "label": "活跃客户数"},
        "time_range": "Last 30 days",
        "compare_lag": 7,
        "compare_suffix": "vs 7d ago",
        "header_format": "{{ value }}",
        "subheader": "近30天活跃客户"
      },
      "query": "SELECT COUNT(DISTINCT customer_id) AS active_customer_count FROM customer_profile WHERE computed_at >= '{{ from_dttm }}' AND computed_at < '{{ to_dttm }}' AND lifecycle_stage='ACTIVE'"
    },
    {
      "slice_name": "客户生命周期分布",
      "viz_type": "pie",
      "datasource_type": "table",
      "datasource_name": "customer_profile",
      "schema": "db_finance",
      "database_name": "finance_doris",
      "description": "按生命周期阶段(NEW/ACTIVE/DORMANT/LOST)统计客户数，饼图",
      "params": {
        "adhoc_filters": [
          {
            "clause": "WHERE",
            "expressionType": "SQL",
            "sqlExpression": "computed_at >= '{{ from_dttm }}' AND computed_at < '{{ to_dttm }}'"
          }
        ],
        "metrics": [{"expressionType": "SQL", "sqlExpression": "COUNT(DISTINCT customer_id)", "label": "客户数"}],
        "groupby": ["lifecycle_stage"],
        "time_range": "Last 30 days",
        "row_limit": 50,
        "color_scheme": "supersetColors",
        "donut": true,
        "show_legend": true
      },
      "query": "SELECT COALESCE(lifecycle_stage,'UNKNOWN') AS lifecycle_stage, COUNT(DISTINCT customer_id) AS customer_count FROM customer_profile WHERE computed_at >= '{{ from_dttm }}' AND computed_at < '{{ to_dttm }}' GROUP BY lifecycle_stage ORDER BY customer_count DESC"
    }
  ],
