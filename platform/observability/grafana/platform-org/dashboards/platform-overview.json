  "panels": [
    {
      "datasource": "Prometheus-Platform",
      "description": "全平台活跃租户数",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "10.4.1",
      "targets": [
        {
          "expr": "count(count by (tenant_id) (shuqing_tenant_active{platform=\"shuqing\"}))",
          "legendFormat": "活跃租户",
          "refId": "A"
        }
      ],
      "title": "活跃租户数",
      "type": "stat"
    },
    {
      "datasource": "Prometheus-Platform",
      "description": "全平台 P0/P1/P2 告警计数",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sum(ALERTS{alertstate=\"firing\",severity=~\"P0|P1|P2\"}) by (severity)",
          "legendFormat": "{{severity}} 告警",
          "refId": "A"
        }
      ],
      "title": "告警分级计数",
      "type": "stat"
    },
    {
      "datasource": "Prometheus-Platform",
      "description": "各组件 CPU 使用率（全租户聚合）",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "showPoints": "never"
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 3,
      "options": { "legend": { "displayMode": "table", "placement": "right" } },
      "targets": [
        {
          "expr": "avg by (component) (rate(process_cpu_seconds_total{component!=\"\"}[5m]) * 100)",
          "legendFormat": "{{component}}",
          "refId": "A"
        }
      ],
      "title": "组件 CPU 使用率",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus-Platform",
      "description": "各租户查询 QPS",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 4,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (tenant_id) (rate(shuqing_query_total[5m]))",
          "legendFormat": "租户 {{tenant_id}}",
          "refId": "A"
        }
      ],
      "title": "租户查询 QPS",
      "type": "timeseries"
    }
