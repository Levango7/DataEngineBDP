<?xml version="1.0" encoding="UTF-8"?>
<!--
  审计日志 Logback 配置（v2.1 审计合规增强）
  说明：审计日志独立输出到 /var/log/dataenginebdp/audit/audit.log，
        滚动归档保留 2555 天（7 年，满足金融行业审计要求）。
-->
<included>
    <!-- 审计日志 Appender -->
    <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>/var/log/dataenginebdp/audit/audit.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>/var/log/dataenginebdp/audit/audit.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>2555</maxHistory>
            <totalSizeCap>100GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 审计日志 Logger（独立于业务日志） -->
    <logger name="AUDIT_LOGGER" level="INFO" additivity="false">
        <appender-ref ref="AUDIT_FILE"/>
    </logger>
</included>
