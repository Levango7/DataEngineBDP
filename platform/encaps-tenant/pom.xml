<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.levango7.dataenginebdp</groupId>
        <artifactId>dataenginebdp-parent</artifactId>
        <version>2.1.0-RC</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <groupId>com.levango7.dataenginebdp</groupId>
    <artifactId>encaps-tenant</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>encaps-tenant</name>
    <description>Shuqing Big Data Platform - Encapsulation Layer (Tenant Domain)</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Swagger Annotations (Jakarta)：OpenAPI 3 @Tag 注解支持 -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
            <version>2.2.22</version>
        </dependency>
        <!-- 封装层跨服务共享实体与仓储（Tenant / Project）。
             2026-10-13 抽出本模块的目的：让 Tenant/ProjectEntity 落在
             `com.levango7.dataenginebdp.encapsshared`（**刻意不是 `...encaps` 的子包**），
             从而 encaps-tenant 的 @EntityScan 可以只列这两个实体所在的包，
             而**不必**列出 `...encaps.model` —— 后者会把 encaps-layer 的全部
             20 个实体一起拉进持久单元（即 V3__baseline_shared_model.sql 那 20 张
             空副本表的来源）。 -->
        <dependency>
            <groupId>com.levango7.dataenginebdp</groupId>
            <artifactId>encaps-shared-model</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>
        <!-- ⚠️ 临时保留：本服务仍借用 encaps-layer 的 `encaps.common`
             （MissingTenantContextException / GlobalExceptionHandler）与
             `encaps.security`（AuditLog 注解 + AuditLogAspect 切面）。
             后者是**等保 2.0（GB/T 22239-2019 8.1.4.3）安全审计项**的实现，
             无条件 @Aspect @Component 装配 —— 直接删掉本依赖会让本服务的
             @AuditLog 静默失效（合规回归）。
             下一步（独立 PR）：把 common/security 那一片一并迁到共享模块后再摘除。 -->
        <dependency>
            <groupId>com.levango7.dataenginebdp</groupId>
            <artifactId>encaps-layer</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>
        <!-- 公共安全 Starter：统一 JwtAuthFilter / TenantContext / SecurityConfig 自动装配 -->
        <dependency>
            <groupId>com.levango7.dataenginebdp</groupId>
            <artifactId>common-security</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- fabric8 Kubernetes Client：workspace/quota 翻译为 K8s Namespace/ResourceQuota -->
        <dependency>
            <groupId>io.fabric8</groupId>
            <artifactId>kubernetes-client</artifactId>
            <version>7.8.0</version>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.85</version>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <version>1.85</version>
        </dependency>
        <!-- Flyway：生产库表结构迁移（prod profile 启用；dev 沿用 H2 + ddl-auto 零配置）。
             版本由 spring-boot-dependencies 统一管理。
             PostgreSQL JDBC 驱动由 encaps-layer 依赖传递引入（runtime scope 可传递）。
             注意：Spring Boot 4 把 Flyway 自动装配拆到 spring-boot-flyway 模块——
             只加 flyway-core 不会有 FlywayAutoConfiguration，迁移不会执行。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- fabric8 mock server：测试中提供 mock KubernetesClient -->
        <dependency>
            <groupId>io.fabric8</groupId>
            <artifactId>kubernetes-server-mock</artifactId>
            <version>7.8.0</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Boot 4：@DataJpaTest 拆分到 spring-boot-starter-data-jpa-test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 生成普通 jar 供其他模块依赖，可执行 jar 带 exec classifier -->
                    <classifier>exec</classifier>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} --add-opens java.base/java.lang=ALL-UNNAMED</argLine>
                    <!-- 2026-10-15：本仓从未配置 failsafe，*IT 类在任何 Maven 生命周期里都不跑。
                         EncapsTenantApplicationIT（全 context 启动冒烟）正是双注册器启动崩溃的
                         守门人，却从未执行——崩溃直漏到 CI 的 docker/E2E 栈才暴露
                         （it-encaps-tenant exited (1)）。显式把 *IT 纳入 surefire 常态运行。
                         K8sWorkspaceTranslatorIT 自带 @EnabledIfSystemProperty(k8s.it=true)，
                         未启用时自动跳过，不阻塞普通构建。 -->
                    <includes>
                        <include>**/Test*.java</include>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*TestCase.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <configuration>
                    <excludes>
                        <exclude>**/model/**</exclude>
                        <exclude>**/*Application*</exclude>
                        <exclude>org/bouncycastle/*</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
