<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.levango7.dataenginebdp</groupId>
        <artifactId>dataenginebdp-parent</artifactId>
        <version>2.1.0-RC</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <groupId>com.levango7.dataenginebdp</groupId>
    <artifactId>flink-cdc</artifactId>
    <version>0.1.0</version>
    <name>flink-cdc</name>
    <description>数据引擎大数据平台 - Flink CDC 管道框架与 MySQL Source 连接器</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <flink.version>1.20.0</flink.version>
        <flink.cdc.version>3.6.0-1.20</flink.cdc.version>
        <flink.kafka.version>3.2.0-1.18</flink.kafka.version>
        <debezium.version>1.9.7.Final</debezium.version>
        <mysql.connector.version>8.2.0</mysql.connector.version>
        <!-- 2026-09-24 安全修复：CVE-2026-42198（HIGH），42.7.3 -> 42.7.11
             2026-09-26 再抬：CVE-2026-54513/54515（HIGH），42.7.11 -> 42.7.13。
             对齐 Spring Boot 4.1.1 BOM 已托管的 42.7.13 —— 其余 19 个模块不写版本、
             由 BOM 直接拿到 42.7.13，只有本模块因显式覆盖才停在旧版。 -->
        <postgres.connector.version>42.7.13</postgres.connector.version>
        <oracle.connector.version>23.26.3.0.0</oracle.connector.version>
        <!-- 2026-09-26 安全修复：CVE-2026-41845/41850/43512/43513（HIGH）。
             取 Trivy 给出的修复版 3.9.2 而非 BOM 的 4.2.1：3.x->4.x 是跨大版本，
             本模块还带着 Debezium 1.9.7，未验证前不冒这个版本跨度。 -->
        <kafka.clients.version>4.4.0</kafka.clients.version>
        <snakeyaml.version>2.7</snakeyaml.version>
        <flink.scope>provided</flink.scope>
    </properties>

    <!-- Flink CDC 3.6.0 的 oracle 连接器传递依赖 org.geotools:gt-main（空间类型支持），
         该 artifact 只在 OSGeo 仓库发布、不在 Maven Central。缺此声明会导致依赖解析失败：
         "Could not find artifact org.geotools:gt-main:jar:28.2"。 -->
    <repositories>
        <repository>
            <id>osgeo</id>
            <name>OSGeo Release Repository</name>
            <url>https://repo.osgeo.org/repository/release/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencies>
        <!-- 公共安全（TenantContext 租户上下文，R8 安全修复） -->
        <dependency>
            <groupId>com.levango7.dataenginebdp</groupId>
            <artifactId>common-security</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>

        <!-- Swagger Annotations (Jakarta)：OpenAPI 3 @Tag 注解支持 -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
            <version>2.2.22</version>
        </dependency>
        <!-- ============ Flink 核心 (集群运行时由 Flink 集群提供) ============ -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-streaming-java</artifactId>
            <version>${flink.version}</version>
            <scope>${flink.scope}</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-clients</artifactId>
            <version>${flink.version}</version>
            <scope>${flink.scope}</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-runtime</artifactId>
            <version>${flink.version}</version>
            <scope>${flink.scope}</scope>
        </dependency>

        <!-- ============ Flink CDC 3.6.0（org.apache.flink 坐标；com.ververica 止于 3.0.1） ============ -->
        <!-- 2026-10-24 迁移：groupId com.ververica → org.apache.flink，包名 com.ververica.cdc.* → org.apache.flink.cdc.*。
             动机：com.ververica 坐标自 3.0.1 起停更，无法再获得修复；3.6.0-1.20 对应 Flink 1.20。
             注意：3.6.0 仍依赖 Debezium 1.9.8.Final（非 2.x）——上游 Flink CDC 3.x 全线未切 2.x，
             故 GHSA-hvw5-3mgw-7rcf（debezium-core < 2.3.0.Alpha1，CWE-233）仍存在，见 PR #631 的关闭说明。 -->
        <!-- MySQL CDC Source 连接器：基于 Debezium 读取 Binlog -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-mysql-cdc</artifactId>
            <version>${flink.cdc.version}</version>
            <exclusions>
                <!-- 2026-11-01 安全修复：Debezium 1.9.8 会传递引入
                     mysql:mysql-connector-java:8.0.28（旧坐标；本地仓库 pom 实测
                     该版本**不带** relocation 元数据、而 8.0.33 才带 ⇒ Maven 不会自动改写
                     旧坐标，8.0.28 会原样进入 classpath），
                     它落在 GHSA-m6vm-37g8-gqvh 的受影响区间
                     （`mysql:mysql-connector-java <= 8.0.33` 无修复版本）。
                     排除后由本模块显式声明的 com.mysql:mysql-connector-j:8.2.0 唯一承担，
                     同时消除「8.0.28 与 8.2.0 两个驱动同 classpath」的版本冲突。 -->
                <exclusion>
                    <groupId>mysql</groupId>
                    <artifactId>mysql-connector-java</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- PostgreSQL CDC Source 连接器：基于 Logical Replication Slot 读取 WAL -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-postgres-cdc</artifactId>
            <version>${flink.cdc.version}</version>
        </dependency>
        <!-- Oracle CDC Source 连接器：基于 LogMiner 读取 Redo Log -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-oracle-cdc</artifactId>
            <version>${flink.cdc.version}</version>
        </dependency>
        <!-- Flink CDC 基础框架：增量快照框架、Source/Sink 抽象 -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-cdc-base</artifactId>
            <version>${flink.cdc.version}</version>
        </dependency>

        <!-- ============ Debezium (CDC 变更事件格式) ============ -->
        <dependency>
            <groupId>io.debezium</groupId>
            <artifactId>debezium-core</artifactId>
            <version>${debezium.version}</version>
        </dependency>
        <dependency>
            <groupId>io.debezium</groupId>
            <artifactId>debezium-embedded</artifactId>
            <version>${debezium.version}</version>
        </dependency>

        <!-- ============ MySQL Connector ============ -->
        <!-- 2026-11-01 安全修复：抬到 8.2.0 并改用反向 DNS 新坐标。
             旧坐标 mysql:mysql-connector-java:8.0.33 已被 Maven 自动 relocated 到
             com.mysql:mysql-connector-j:8.0.33（Oracle 在 8.0.33 后迁移坐标），而通告
             GHSA-m6vm-37g8-gqvh（MySQL Connectors takeover vulnerability）的受影响区间是
             `com.mysql:mysql-connector-j < 8.2.0`、修复版本 **8.2.0** ⇒ 旧坐标写法即便
             relocation 到新坐标，版本仍落在受影响区间内。
             旧坐标 `mysql:mysql-connector-java <= 8.0.33` 在上游**无修复版本**（坐标已改名），
             故只能迁移坐标 + 抬版本，不能原地升版。
             本机实测（离线依赖树）：改前解析为 com.mysql:mysql-connector-j:8.0.33（compile）。 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql.connector.version}</version>
        </dependency>

        <!-- ============ PostgreSQL Connector (JDBC + Logical Replication) ============ -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgres.connector.version}</version>
        </dependency>

        <!-- ============ Oracle Connector (JDBC + LogMiner) ============ -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc8</artifactId>
            <version>${oracle.connector.version}</version>
        </dependency>

        <!-- ============ Kafka Client (Sink 写入 Kafka) ============ -->
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>${kafka.clients.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-kafka</artifactId>
            <version>${flink.kafka.version}</version>
            <scope>${flink.scope}</scope>
        </dependency>
        <!-- Flink Connector Base: DeliveryGuarantee 等基础抽象 -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-base</artifactId>
            <version>${flink.version}</version>
            <scope>${flink.scope}</scope>
        </dependency>

        <!-- ============ YAML 配置解析 ============ -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>${snakeyaml.version}</version>
        </dependency>

        <!-- ============ Jackson (Debezium JSON 序列化) ============ -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- ============ Spring Boot Web (物化视图管理 REST API) ============ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ============ Lombok ============ -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ============ 日志 ============ -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>

        <!-- ============ 测试 ============ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-test-utils</artifactId>
            <version>${flink.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- flink-core 直接声明（provided scope 的传递依赖在测试编译时不可用） -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-core</artifactId>
            <version>${flink.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- flink-runtime test-jar：提供测试用状态后端工具 -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-runtime</artifactId>
            <version>${flink.version}</version>
            <scope>test</scope>
            <type>test-jar</type>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-streaming-java</artifactId>
            <version>${flink.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <!-- 测试用 testcontainers 启动 MySQL 容器验证 Binlog 读取 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>1.21.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <version>1.21.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>1.21.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>oracle-xe</artifactId>
            <version>1.19.7</version>
            <scope>test</scope>
        </dependency>
        <!-- Mockito 用于 Mock Builder 单元测试 -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} --add-opens java.base/java.lang=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
            <!-- 生成可提交到 Flink 集群的 fat jar (含依赖) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <artifactSet>
                                <excludes>
                                    <exclude>org.apache.flink:flink-shaded-force-shading</exclude>
                                    <exclude>com.google.code.findbugs:jsr305</exclude>
                                    <exclude>org.slf4j:*</exclude>
                                    <exclude>org.apache.logging.log4j:*</exclude>
                                </excludes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- JaCoCo 覆盖率 (要求 ≥80%) -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <configuration>
                    <excludes>
                        <exclude>**/model/**</exclude>
                        <exclude>**/CdcFrameworkMain*</exclude>

                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>coverage-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Checkstyle：代码风格检查（CI 阻断） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <configLocation>../../build/lint/checkstyle.xml</configLocation>
                    <failOnViolation>true</failOnViolation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <consoleOutput>false</consoleOutput>
                    <violationSeverity>warning</violationSeverity>
                    <resourceExcludes>**/*.yml,**/*.yaml,**/*.properties,**/*.xml,**/*.json</resourceExcludes>
                </configuration>
            </plugin>
            <!-- PMD：静态分析（CI 阻断） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>3.21.2</version>
                <configuration>
                    <rulesets>
                        <ruleset>../../build/lint/pmd-ruleset.xml</ruleset>
                    </rulesets>
                    <failOnViolation>true</failOnViolation>
                    <includeTests>true</includeTests>
                    <minimumPriority>5</minimumPriority>
                    <skipPmdError>true</skipPmdError>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>