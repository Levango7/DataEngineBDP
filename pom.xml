<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.levango7.dataenginebdp</groupId>
    <artifactId>dataenginebdp-parent</artifactId>
    <version>2.1.0-RC</version>
    <packaging>pom</packaging>
    <name>DataEngineBDP Parent</name>
    <description>数据引擎大数据平台 - 统一父POM，管理所有子模块版本</description>

    <properties>
        <!-- Spring Boot 4.1.x 要求 JDK 17+（本升级保持 17，后续可评估 25 LTS） -->
        <java.version>17</java.version>
        <spring-boot.version>4.1.1</spring-boot.version>
        <!-- 2026-09-24 安全修复：覆盖 Spring Boot 4.1.1 托管的 tomcat 版本。
             11.0.24 存在 3 个 CRITICAL（CVE-2026-65182 / 65905 / 68525），
             Trivy 给出修复版本 11.0.25（patch 级，兼容性风险极低）。
             该项在全仓 fs 扫描中命中 141 次，占全部漏洞约 30%。 -->
        <tomcat.version>11.0.25</tomcat.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 2026-09-24 安全修复（低风险批次；Trivy fs HIGH/CRITICAL）：
                 以下两项为传递依赖，全仓未显式声明版本，故在此集中 pin 到已修复版本。
                 · bouncycastle 1.75/1.78.1 -> 1.85
                   CVE-2025-14813 / CVE-2026-8763 (CRITICAL) / CVE-2026-13506 (HIGH)
                   1.85 与 encaps-layer 既有版本一致，jdk18on 同分支 minor 升级，风险低。
                 · lz4-java 1.8.0 -> 1.8.1（CVE-2025-12183，patch 级） -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>1.85</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcpkix-jdk18on</artifactId>
                <version>1.85</version>
            </dependency>
            <dependency>
                <groupId>org.lz4</groupId>
                <artifactId>lz4-java</artifactId>
                <version>1.8.1</version>
            </dependency>
            <!-- 2026-09-24 安全修复：commons-compress 1.22 为传递依赖（全仓未显式声明），
                 在此集中 pin。CVE-2023-42503 / CVE-2024-25710 / CVE-2024-26308。 -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-compress</artifactId>
                <version>1.26.0</version>
            </dependency>
            <!-- 2026-09-26 安全修复（Trivy fs run #1241 明细；三项均为传递依赖，
                 全仓无显式版本声明，故按上面同款做法在此集中 pin）：
                 · avro 1.9.2 / 1.11.3 -> 1.11.4（CRITICAL）
                   引入链：hadoop-client 3.4.1 -> hadoop-common -> avro（metadata-collector）；
                           iceberg-core 1.5.2 -> avro（real-time-pipeline、stream-batch-scheduler）。
                 · commons-beanutils 1.9.4 -> 1.11.0（HIGH）
                   引入链：hadoop-client -> hadoop-common -> commons-beanutils（metadata-collector）。
                   注：finops/dashboard 经 opencsv 已经是 1.11.0，此处对齐而非另起一套。
                 · aircompressor 0.26 -> 2.0.3（HIGH，CVE-2025-67721）
                   引入链：iceberg-core 1.5.2 -> aircompressor。
                   注：先试过保守的 0.27，实测 Trivy 仍报同一条 —— 该 CVE 的修复版
                   只有 2.0.3，0.27 不在修复范围内，保守版本等于白抬。故取 2.0.3，
                   并对 real-time-pipeline / stream-batch-scheduler 跑全量单测验证。
                   ⚠ 残留风险：这两个模块的 Iceberg 读写路径若无单测覆盖，
                   单测绿不等于运行期无事，首次实跑 Iceberg 表时需重点观察。 -->
            <dependency>
                <groupId>org.apache.avro</groupId>
                <artifactId>avro</artifactId>
                <version>1.11.4</version>
            </dependency>
            <dependency>
                <groupId>commons-beanutils</groupId>
                <artifactId>commons-beanutils</artifactId>
                <version>1.11.0</version>
            </dependency>
            <dependency>
                <groupId>io.airlift</groupId>
                <artifactId>aircompressor</artifactId>
                <version>2.0.3</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Spring Boot 4 公共依赖：默认 JSON 栈切换为 Jackson 3（tools.jackson），
         而平台代码全部使用 Jackson 2（com.fasterxml）。spring-boot-jackson2 提供
         Jackson2AutoConfiguration（自动装配 jackson2 ObjectMapper bean），由父 POM
         统一注入，子模块无需逐个声明（EncapsLayer EvidenceArchive 等 22 处注入点）。
         同理 WebClient.Builder 自动配置移入 spring-boot-webclient 模块
         （metadata-collector/infra-orchestrator/scheduler 注入 WebClient.Builder）。 -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webclient</artifactId>
        </dependency>
    </dependencies>

    <modules>
        <module>platform/common-security</module>
        <module>platform/encaps-data</module>
        <module>platform/encaps-gateway</module>
        <module>platform/encaps-layer</module>
        <module>platform/encaps-tenant</module>
        <module>platform/finops/billing</module>
        <module>platform/finops/cost-model</module>
        <module>platform/finops/dashboard</module>
        <module>platform/flink-cdc</module>
        <module>platform/governance/lineage-analyzer</module>
        <module>platform/governance/metadata-collector</module>
        <module>platform/governance/real-time-pipeline</module>
        <module>platform/infra-orchestrator</module>
        <module>platform/infra-provider-cloud</module>
        <module>platform/infra-provider-private</module>
        <module>platform/infra-provider-xinchang</module>
        <module>platform/karmada/federated-query</module>

        <module>platform/data-standard</module>
        <module>platform/master-data</module>
        <module>platform/rule-engine</module>
        <module>platform/sql-gateway</module>
        <module>platform/storage-io</module>
        <module>platform/stream-batch-scheduler</module>
        <module>platform/tag-engine</module>
    </modules>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>