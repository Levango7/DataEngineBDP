<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.levango7.dataenginebdp</groupId>
    <artifactId>dataenginebdp-parent</artifactId>
    <version>2.1.0-RC</version>
    <packaging>pom</packaging>
    <name>DataEngineBDP Parent</name>
    <description>数据引擎大数据平台 - 统一父POM，管理所有子模块版本</description>

    <properties>
        <!-- Spring Boot 4.1.x 要求 JDK 17+（本升级保持 17，后续可评估 25 LTS） -->
        <java.version>17</java.version>
        <spring-boot.version>4.1.1</spring-boot.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Spring Boot 4 公共依赖：默认 JSON 栈切换为 Jackson 3（tools.jackson），
         而平台代码全部使用 Jackson 2（com.fasterxml）。spring-boot-jackson2 提供
         Jackson2AutoConfiguration（自动装配 jackson2 ObjectMapper bean），由父 POM
         统一注入，子模块无需逐个声明（EncapsLayer EvidenceArchive 等 22 处注入点）。
         同理 WebClient.Builder 自动配置移入 spring-boot-webclient 模块
         （metadata-collector/infra-orchestrator/scheduler 注入 WebClient.Builder）。 -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webclient</artifactId>
        </dependency>
    </dependencies>

    <modules>
        <module>platform/common-security</module>
        <module>platform/encaps-data</module>
        <module>platform/encaps-gateway</module>
        <module>platform/encaps-layer</module>
        <module>platform/encaps-tenant</module>
        <module>platform/finops/cost-model</module>
        <module>platform/finops/dashboard</module>
        <module>platform/flink-cdc</module>
        <module>platform/governance/lineage-analyzer</module>
        <module>platform/governance/metadata-collector</module>
        <module>platform/governance/real-time-pipeline</module>
        <module>platform/infra-orchestrator</module>
        <module>platform/infra-provider-cloud</module>
        <module>platform/infra-provider-private</module>
        <module>platform/infra-provider-xinchang</module>
        <module>platform/karmada/federated-query</module>
        <module>platform/knative/runtimes/java</module>
        <module>platform/rule-engine</module>
        <module>platform/sql-gateway</module>
        <module>platform/storage-io</module>
        <module>platform/stream-batch-scheduler</module>
        <module>platform/tag-engine</module>
    </modules>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.15.0</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>